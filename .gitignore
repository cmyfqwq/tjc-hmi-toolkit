*.HMI
*.hmi
*.tft
*.page
*.pa
*.zi
extracted/
exported/
pa_samples/
backup/

# ---- 运行产物 / 临时文件 ----
*.tmp
_*.bin
__pycache__/
*.pyc
*.pyo
*.bak
*.bak-*
*.keep

# ---- 编辑器 / 系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
